# systemd unit per il relay hf-gateway su un VPS (es. community.ft2.it)
#
# Installazione:
#   sudo cp hf_relay.py /opt/hf-relay/hf_relay.py
#   sudo cp hf-relay.service /etc/systemd/system/
#   sudo ufw allow 5555/udp          # apri la porta sul firewall
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hf-relay
#   sudo systemctl status hf-relay   # verifica
#   journalctl -u hf-relay -f        # log in tempo reale (chi entra nelle stanze)

[Unit]
Description=hf-gateway relay (rendez-vous UDP per Decodium FT2-Link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/hf-relay/hf_relay.py 5555
Restart=always
RestartSec=3
# hardening minimo
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
