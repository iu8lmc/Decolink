# systemd unit per il servizio di accesso di Decolink (registrazione, login,
# pannello di gestione).
#
# Qui viaggiano le password, quindi il servizio NON va esposto in chiaro:
# ascolta solo su 127.0.0.1 e davanti ci si mette nginx con HTTPS. Esempio di
# blocco nginx:
#
#   server {
#       listen 443 ssl;
#       server_name decolink.ft2.it;
#       ssl_certificate     /etc/letsencrypt/live/decolink.ft2.it/fullchain.pem;
#       ssl_certificate_key /etc/letsencrypt/live/decolink.ft2.it/privkey.pem;
#       location / {
#           proxy_pass http://127.0.0.1:8080;
#           proxy_set_header Host $host;
#           proxy_set_header X-Forwarded-For $remote_addr;   # serve al freno sui login
#       }
#   }
#
# Chi non vuole nginx puo' far parlare HTTPS direttamente a questo servizio
# aggiungendo --cert e --key a ExecStart e mettendo --host 0.0.0.0.

[Unit]
Description=Decolink — servizio di accesso (utenti, stazioni, permessi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=decolink
Group=decolink
WorkingDirectory=/opt/decolink
ExecStart=/usr/bin/python3 /opt/decolink/decolink_web.py --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/decolink

[Install]
WantedBy=multi-user.target
